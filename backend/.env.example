# Copy to .env and adjust locally. Do not put real passwords here.
# Local: postgresql://USER@127.0.0.1:5432/cafeflow
# Hosted Postgres: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Never commit the real DATABASE_URL.
DATABASE_URL="postgresql://USER@127.0.0.1:5432/cafeflow"

PORT=3000
HOST=0.0.0.0

# development | production
NODE_ENV=development

# Firebase Auth project (not a secret). ID token verification uses this project.
FIREBASE_PROJECT_ID=cafeflow-5tg

# Optional extra CORS origins, comma-separated. Local Flutter web (:8765) is
# allowed when NODE_ENV is not production. The PWA origin
# https://cafeflow-5tg.web.app is always allowed.
# CORS_ORIGINS=https://example.com

# Optional local Admin credentials. Never commit the JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
